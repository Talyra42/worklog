# Supabase Dashboard → Project Settings → API
# Project URL，例如 https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# anon / publishable key（可以公开在前端，权限由 RLS 控制）
# 新版 Supabase 叫 publishable key（sb_publishable_...），旧版叫 anon key（eyJ...）。
# 二选一填写即可；绝对不要把 secret / service_role key 放进这里。
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
